# ============================================================================
# POLICY LENS — ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env and replace all placeholder values
#
#   cp .env.example .env
#
# SECURITY: NEVER commit .env to version control!
# ============================================================================

# ---- App ----
APP_NAME=DentalSchemes India
DEBUG=true
SECRET_KEY=CHANGE-ME-generate-with-openssl-rand-hex-32

# ---- Database (PostgreSQL) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE-ME-strong-password
POSTGRES_DB=dentalschemes
DATABASE_URL=postgresql://postgres:CHANGE-ME-strong-password@db:5432/dentalschemes

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- JWT Authentication ----
JWT_SECRET_KEY=CHANGE-ME-generate-with-openssl-rand-hex-64
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- CORS ----
# Comma-separated list of allowed origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8081"]

# ---- Admin Frontend ----
VITE_API_URL=http://localhost:8000/api/v1

# ---- SMS / OTP ----
SMS_API_KEY=your-sms-api-key
SMS_PROVIDER=msg91
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=3
OTP_MAX_REQUESTS_PER_HOUR=5

# ---- Security ----
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# ---- File Upload ----
MAX_UPLOAD_SIZE_MB=10
S3_BUCKET=dentalschemes-docs
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# ---- AI / LLM ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_TIMEOUT_SECONDS=60

# ---- Ollama (Local LLM) ----
# Set to host.docker.internal when running in Docker, or localhost for local dev
OLLAMA_HOST=host.docker.internal
