# Policy-Lens Docker Compose Environment Variables
# Copy this file to .env and update with your actual values

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=dentalschemes

# Backend Configuration
DATABASE_URL=postgresql://postgres:change-me-in-production@db:5432/dentalschemes
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=your-jwt-secret-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
DEBUG=false

# Admin Frontend Configuration
VITE_API_URL=http://localhost:8000/api/v1
VITE_API_PROXY_URL=http://backend:8000
VITE_TOKEN_REFRESH_INTERVAL=300000

# Mobile App Configuration
EXPO_PUBLIC_API_URL=https://api.dentalschemes.in/api/v1
