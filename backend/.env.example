# DentalSchemes India - Backend Environment Variables

# App
APP_NAME="DentalSchemes India"
DEBUG=false
SECRET_KEY=your-secret-key-change-in-production

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dentalschemes

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=your-jwt-secret-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:19006"]
ALLOWED_HOSTS=["*"]

# File Upload
MAX_UPLOAD_SIZE_MB=10
ALLOWED_FILE_TYPES=["application/pdf","image/jpeg","image/png","image/tiff"]
S3_BUCKET=dentalschemes-docs
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# AI/LLM
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key
AI_TIMEOUT_SECONDS=60

# SMS/OTP
SMS_API_KEY=your-sms-api-key
SMS_PROVIDER=msg91
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=3
OTP_MAX_REQUESTS_PER_HOUR=5

# Security
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30
